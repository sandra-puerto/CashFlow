# Imagen base de PHP CLI
FROM php:8.2-cli

# Instalar dependencias del sistema y librerías necesarias para extensiones PHP
RUN apt-get update && apt-get install -y --no-install-recommends \
    git unzip zip curl gnupg ca-certificates nano bash procps \
    libzip-dev libpng-dev libonig-dev libxml2-dev libpq-dev \
    libsqlite3-dev libjpeg-dev libfreetype6-dev zlib1g-dev \
    libxslt-dev default-mysql-client libicu-dev pkg-config \
    && docker-php-ext-configure gd --with-jpeg --with-freetype \
    && docker-php-ext-install pdo pdo_mysql mbstring zip exif pcntl bcmath gd intl xsl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Instalar Composer globalmente
RUN curl -sS https://getcomposer.org/installer | php && \
    mv composer.phar /usr/local/bin/composer

# Instalar Node.js LTS (v22) y npm
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g npm && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Directorio de trabajo en el contenedor
WORKDIR /app

# Opcional: mostrar versiones para verificar instalación
RUN php -v && composer --version && node -v && npm -v